/* Base CSS Stylesheet for LANY Music CLI */

$primary-bg: #432832;
$panel-bg: #4f313c;
$accent: #d38e91;
$text-primary: #fbe5e6;
$text-muted: #a68894;
$border: #7a5260;

* {
    transition: background 500ms;
}

Screen {
    background: $primary-bg;
    color: $text-primary;
    font-family: monospace;
}

#main-layout {
    layout: horizontal;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    background: $primary-bg;
}

#player-pane {
    width: 33%;
    height: 100%;
    background: $panel-bg;
    border: tall $border;
    border-title-color: $accent;
    border-title-style: bold;
    padding: 1 2;
    margin: 0 1 0 0;
    content-align: center top;
}

#eq-pane {
    width: 34%;
    height: 100%;
    background: $panel-bg;
    border: tall $border;
    border-title-color: $accent;
    border-title-style: bold;
    padding: 1 1;
    margin: 0 1 0 0;
    layout: vertical;
}

#right-pane {
    width: 33%;
    height: 100%;
    layout: vertical;
}

#lyrics-view {
    height: 45%;
    background: $panel-bg;
    border: tall $border;
    border-title-color: $accent;
    border-title-style: bold;
    padding: 0 1;
    margin: 0 0 1 0;
}

#queue-view {
    height: 55%;
    background: $panel-bg;
    border: tall $border;
    border-title-color: $accent;
    border-title-style: bold;
    padding: 0 1;
}

/* Left Pane Widgets styling */
AlbumArt {
    width: 36;
    height: 16;
    border: double $border;
    margin: 1 0;
    background: $primary-bg;
    content-align: center middle;
}

.track-title {
    text-style: bold;
    color: $text-primary;
    height: auto;
    text-align: center;
    width: 100%;
}

.track-artist {
    color: $text-muted;
    height: auto;
    text-align: center;
    width: 100%;
    margin-bottom: 1;
}

#favorite-and-menu {
    layout: horizontal;
    height: 1;
    align: center middle;
    width: 100%;
    margin-bottom: 1;
}

#favorite-btn {
    color: $accent;
    text-style: bold;
    width: 4;
}

#menu-btn {
    color: $text-muted;
    width: 4;
}

#progress-container {
    layout: horizontal;
    height: 1;
    align: center middle;
    width: 100%;
    margin: 1 0;
}

#play-time {
    color: $text-muted;
    width: 6;
    text-align: left;
}

#remaining-time {
    color: $text-muted;
    width: 7;
    text-align: right;
}

#progress-track {
    width: 1fr;
    color: $accent;
    background: $primary-bg;
    height: 1;
}

#bitrate-container {
    layout: horizontal;
    align: center middle;
    width: 100%;
    height: 1;
    margin-bottom: 1;
}

#bitrate-badge {
    background: $accent;
    color: $primary-bg;
    text-style: bold;
    padding: 0 1;
    height: 1;
}

#media-controls {
    layout: horizontal;
    align: center middle;
    width: 100%;
    height: 3;
}

#media-controls Button {
    min-width: 4;
    margin: 0 1;
    background: transparent;
    border: none;
    color: $text-primary;
}

#media-controls Button:hover {
    color: $accent;
}

/* EQ & Visualizer Styling */
.eq-title {
    color: $accent;
    text-style: bold;
    text-align: center;
    margin-bottom: 1;
}

#eq-preset-container {
    layout: horizontal;
    align: center middle;
    width: 100%;
    height: 3;
    margin-bottom: 1;
}

#eq-sliders {
    layout: horizontal;
    align: center bottom;
    width: 100%;
    height: 14;
    margin-bottom: 1;
}

.eq-col {
    layout: vertical;
    align: center bottom;
    width: 12%;
    height: 100%;
}

.eq-bar {
    width: 1;
    height: 100%;
    color: $accent;
}

.eq-label {
    text-align: center;
    color: $text-muted;
    font-size: 8;
    height: 1;
}

#vis-container {
    width: 100%;
    height: 12;
    border-top: dashed $border;
    margin-top: 1;
    padding-top: 1;
}

#eq-vis-toggle {
    layout: horizontal;
    align: center middle;
    width: 100%;
    height: 1;
    margin-top: 1;
}

.toggle-btn {
    color: $text-muted;
    margin: 0 2;
    text-style: bold;
}

.toggle-btn.active {
    color: $accent;
    border-bottom: solid $accent;
}

/* Lyrics & Queue styling */
.lyric-line {
    text-align: center;
    width: 100%;
    padding: 0 1;
    height: auto;
}

.lyric-line.active {
    color: $text-primary;
    text-style: bold;
}

.lyric-line.inactive {
    color: $text-muted;
}

#queue-list {
    width: 100%;
    height: 100%;
    background: transparent;
    padding: 0;
    margin: 0;
}

.queue-item {
    layout: horizontal;
    align: left middle;
    height: 3;
    width: 100%;
    padding: 0 1;
    margin-bottom: 1;
    border-bottom: thin $border;
}

.queue-thumb {
    width: 3;
    height: 2;
    background: $accent;
    margin-right: 2;
}

.queue-details {
    layout: vertical;
    width: 1fr;
}

.queue-title {
    color: $text-primary;
    text-style: bold;
}

.queue-artist {
    color: $text-muted;
}

#queue-header {
    layout: horizontal;
    height: 1;
    align: right middle;
    width: 100%;
    margin-bottom: 1;
}

#autoplay-lbl {
    color: $accent;
    text-style: bold;
    text-align: right;
    width: 100%;
    margin-right: 1;
}

.active-track {
    background: $accent;
    color: $primary-bg;
}

.active-track .queue-title {
    color: $primary-bg;
    text-style: bold;
}

.active-track .queue-artist {
    color: $primary-bg;
}

