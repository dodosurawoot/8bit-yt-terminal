/* Base TCSS Stylesheet for YT-Terminal */

$primary-bg: #1c1216;      /* Deeper dark rose (near-black) */
$panel-bg: #2a1a22;        /* Slightly lighter rose panel */
$accent: #e8959a;          /* Dusty pink/accent pop */
$text-primary: #fff0f0;    /* Warm white/light pink */
$text-muted: #7a5a68;      /* Muted mauve text */
$border: #3c2633;          /* Subtle rose border */

* {
    transition: background 800ms;
}

Screen {
    background: $primary-bg;
    color: $text-primary;
}

#main-layout {
    layout: horizontal;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    background: $primary-bg;
}

#player-pane {
    width: 1fr;
    min-width: 38;
    height: 100%;
    background: $panel-bg;
    border: round $border;
    border-title-color: $accent;
    border-title-style: bold;
    padding: 1 2;
    margin: 0 1 0 0;
    content-align: center top;
}

#eq-pane {
    width: 1fr;
    min-width: 36;
    height: 100%;
    background: $panel-bg;
    border: round $border;
    border-title-color: $accent;
    border-title-style: bold;
    padding: 1 1;
    margin: 0 1 0 0;
    layout: vertical;
}

#right-pane {
    width: 1fr;
    min-width: 32;
    height: 100%;
    layout: vertical;
}

#lyrics-view {
    height: 45%;
    background: $panel-bg;
    border: round $border;
    border-title-color: $accent;
    border-title-style: bold;
    padding: 0 1;
    margin: 0 0 1 0;
}

#queue-view {
    height: 55%;
    background: $panel-bg;
    border: round $border;
    border-title-color: $accent;
    border-title-style: bold;
    padding: 0 1;
    layout: vertical;
}

/* Left Pane Widgets styling */
AlbumArt {
    width: 36;
    height: 14;
    border: round $border;
    margin: 1 0;
    background: $primary-bg;
    content-align: center middle;
}

.track-title {
    text-style: bold;
    color: $text-primary;
    height: auto;
    text-align: center;
    width: 100%;
}

.track-artist {
    color: $text-muted;
    height: auto;
    text-align: center;
    width: 100%;
    margin-bottom: 1;
}

#favorite-and-menu {
    layout: horizontal;
    height: 1;
    align: center middle;
    width: 100%;
    margin-bottom: 1;
}

#favorite-btn {
    color: $accent;
    text-style: bold;
    width: 4;
}

#menu-btn {
    color: $text-muted;
    width: 4;
}

#progress-container {
    layout: horizontal;
    height: 1;
    align: center middle;
    width: 100%;
    margin: 2 0 1 0;
}

#play-time {
    color: $text-muted;
    width: 6;
    text-align: left;
}

#remaining-time {
    color: $text-muted;
    width: 7;
    text-align: right;
}

#progress-track {
    width: 1fr;
    color: $accent;
    background: $border;
    height: 1;
}

#bitrate-container {
    layout: horizontal;
    align: center middle;
    width: 100%;
    height: 1;
    margin-bottom: 1;
}

#bitrate-badge {
    background: $primary-bg;
    color: $accent;
    text-style: bold italic;
    padding: 0 1;
    height: 1;
}

#media-controls {
    layout: horizontal;
    align: center middle;
    width: 100%;
    height: 3;
}

#media-controls Button {
    min-width: 4;
    margin: 0 2;
    background: transparent;
    border: none;
    color: $text-primary;
    text-style: bold;
}

#media-controls Button:hover {
    color: $accent;
    text-style: bold;
}

/* EQ & Visualizer Styling */
EqualizerWidget {
    height: 13;
    width: 100%;
}

.eq-title {
    color: $accent;
    text-style: bold;
    text-align: center;
    margin-bottom: 1;
}

#eq-preset-container {
    layout: horizontal;
    align: center middle;
    width: 100%;
    height: 3;
    margin-bottom: 1;
}

#eq-sliders {
    layout: horizontal;
    align: center bottom;
    width: 100%;
    height: 7; /* Compact vertical compression */
    margin-bottom: 0;
}

.eq-col {
    layout: vertical;
    align: center bottom;
    width: 1fr; /* Distribute evenly across Center Pane */
    height: 100%;
}

.eq-bar {
    width: 1;
    height: 5; /* Compact vertical slider bar */
    color: $accent;
}

.eq-label {
    text-align: center;
    color: $text-muted;
    height: 1;
}

#vis-container {
    width: 100%;
    height: 8; /* Compact roomy space for spectrum visualizer */
    margin-top: 1;
    padding: 0;
}

SpectrumVisualizer {
    width: 100%;
    height: 6;
    content-align: center middle; /* Perfectly center the 28-column spectrum bars */
}

#eq-vis-toggle {
    layout: horizontal;
    align: center middle;
    width: 100%;
    height: 1;
    margin-top: 0;
}

.toggle-btn {
    color: $text-muted;
    margin: 0 2;
    text-style: bold;
}

.toggle-btn.active {
    color: $accent;
    border-bottom: solid $accent;
}

/* Lyrics & Queue styling */
.lyric-line {
    text-align: center;
    width: 100%;
    padding: 0 1;
    height: auto;
    transition: color 500ms, text-style 500ms;
}

.lyric-line.active {
    color: $text-primary;
    text-style: bold underline;
    padding: 1 1;
}

.lyric-line.near-active {
    color: $text-muted; /* Mid-level focus */
}

.lyric-line.inactive {
    color: $border; /* Muted fade */
}

#queue-list {
    width: 100%;
    height: 100%;
    background: transparent;
    padding: 0;
    margin: 0;
}

QueueItemWidget {
    height: 2;
    width: 100%;
}

.queue-item {
    layout: horizontal;
    align: left middle;
    height: 2;
    width: 100%;
    padding: 0 1;
    margin-bottom: 0;
    border-bottom: none; /* Borderless Apple style */
}

.queue-thumb {
    width: 3;
    height: 1;
    background: $border;
    margin-right: 2;
    content-align: center middle;
}

.queue-details {
    layout: vertical;
    width: 1fr;
}

.queue-title {
    color: $text-primary;
    text-style: bold;
}

.queue-artist {
    color: $text-muted;
}

#queue-header {
    layout: horizontal;
    height: 2;
    align: center middle;
    width: 100%;
    margin-bottom: 1;
    border-bottom: solid $border;
}

#autoplay-lbl {
    color: $accent;
    text-style: bold;
    text-align: right;
    width: 100%;
    margin-right: 1;
}

.active-track {
    background: $panel-bg;
    color: $text-primary;
    border-left: thick $accent; /* Vertical accent bar */
}

.active-track .queue-title {
    color: $accent;
    text-style: bold;
}

.active-track .queue-artist {
    color: $text-muted;
}

/* Immersive Full-Screen Lyrics Mode rules */
#main-layout.fullscreen-lyrics-active #player-pane {
    display: none;
}
#main-layout.fullscreen-lyrics-active #eq-pane {
    display: none;
}
#main-layout.fullscreen-lyrics-active #queue-view {
    display: none;
}
#main-layout.fullscreen-lyrics-active #right-pane {
    width: 1fr;
    height: 100%;
}
#main-layout.fullscreen-lyrics-active #lyrics-view {
    height: 100%;
    border: none;
}

