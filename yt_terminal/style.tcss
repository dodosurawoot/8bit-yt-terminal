/* Premium Obsidian Synthwave TCSS Stylesheet for YT-Terminal */

$primary-bg: #0a0b10;      /* Deep obsidian midnight */
$panel-bg: #131520;        /* Translucent glass panel */
$accent: #00f3ff;          /* Cyber cyan accent */
$accent-pink: #ff2a7a;     /* Synthwave hot pink accent */
$text-primary: #f5f6fa;    /* Crisp ice-white text */
$text-muted: #686d80;      /* Translucent slate-gray text */
$border: #262938;          /* Rounded border tint */

* {
    transition: background 800ms;
}

Screen {
    background: $primary-bg;
    color: $text-primary;
}

#main-layout {
    layout: horizontal;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    background: $primary-bg;
}

#player-pane {
    width: 34%;
    min-width: 40;
    height: 100%;
    background: $panel-bg;
    border: round $border;
    border-title-color: $accent;
    border-title-style: bold;
    padding: 1 2;
    margin: 0 1 0 1;
    content-align: center top;
}

#eq-pane {
    width: 32%;
    min-width: 36;
    height: 100%;
    background: $panel-bg;
    border: round $border;
    border-title-color: $accent-pink;
    border-title-style: bold;
    padding: 1 2;
    margin: 0 1;
    layout: vertical;
    align: center middle;
}

#right-pane {
    width: 34%;
    min-width: 34;
    height: 100%;
    layout: vertical;
    margin: 0 1 0 0;
}

#lyrics-view {
    height: 48%;
    background: $panel-bg;
    border: round $border;
    border-title-color: $accent;
    border-title-style: bold;
    padding: 1 2;
    margin: 0 0 1 0;
}

#queue-view {
    height: 52%;
    background: $panel-bg;
    border: round $border;
    border-title-color: $accent-pink;
    border-title-style: bold;
    padding: 1 2;
    layout: vertical;
}

/* Left Pane Widgets styling */
AlbumArt {
    width: 100%;
    height: 1fr;
    min-height: 8;
    max-height: 20;
    border: round $accent;
    margin: 1 0;
    background: $primary-bg;
    content-align: center middle;
}

.track-title {
    text-style: bold;
    color: $text-primary;
    height: auto;
    text-align: center;
    width: 100%;
    margin-top: 1;
}

.track-artist {
    color: $text-muted;
    height: auto;
    text-align: center;
    width: 100%;
    margin-bottom: 1;
}

#favorite-and-menu {
    layout: horizontal;
    height: 1;
    align: center middle;
    width: 100%;
    margin-bottom: 1;
}

#favorite-btn {
    color: $accent-pink;
    text-style: bold;
    width: 4;
    text-align: center;
    transition: color 300ms, background 300ms;
}

#favorite-btn:hover {
    color: #ffffff;
    background: #ff2a7a 20%;
}

#menu-btn {
    color: $text-muted;
    width: 4;
    text-align: center;
    transition: color 300ms, background 300ms;
}

#menu-btn:hover {
    color: $accent;
    background: #00f3ff 20%;
}

#progress-container {
    layout: horizontal;
    height: 1;
    align: center middle;
    width: 100%;
    margin: 2 0 1 0;
}

#play-time {
    color: $text-muted;
    width: 6;
    text-align: left;
}

#remaining-time {
    color: $text-muted;
    width: 7;
    text-align: right;
}

#progress-track {
    width: 1fr;
    color: $accent;
    background: $border;
    height: 1;
}

#bitrate-container {
    layout: horizontal;
    align: center middle;
    width: 100%;
    height: 1;
    margin-bottom: 1;
}

#bitrate-badge {
    background: $primary-bg;
    color: $accent-pink;
    border: round $border;
    text-style: bold;
    padding: 0 2;
    height: 1;
}

#media-controls {
    layout: horizontal;
    align: center middle;
    width: 100%;
    height: 3;
    margin-top: 1;
}

#media-controls Button {
    min-width: 5;
    margin: 0 1;
    background: #181926;
    border: tall #2a2c3d;
    color: $text-primary;
    text-style: bold;
    height: 3;
}

#media-controls Button:hover {
    background: #25283b;
    color: $accent;
    border: tall $accent;
}

/* EQ & Visualizer Styling */
EqualizerWidget {
    height: 13;
    width: 100%;
}

.eq-title {
    color: $accent;
    text-style: bold;
    text-align: center;
    margin-bottom: 1;
}

#eq-preset-container {
    layout: horizontal;
    align: center middle;
    width: 100%;
    height: 3;
    margin-bottom: 1;
}

#eq-sliders {
    layout: horizontal;
    align: center bottom;
    width: 100%;
    height: 7;
    margin-bottom: 0;
}

.eq-col {
    layout: vertical;
    align: center bottom;
    width: 1fr;
    height: 100%;
}

.eq-bar {
    width: 1;
    height: 5;
    color: $accent;
}

.eq-label {
    text-align: center;
    color: $text-muted;
    height: 1;
}

#vis-container {
    width: 100%;
    height: 10;
    margin-top: 1;
    padding: 0;
}

SpectrumVisualizer {
    border: round $border;
    border-title-align: center;
    border-title-color: $accent;
    width: 100%;
    height: 8;
    content-align: center bottom;
    background: transparent;
}

SpectrumVisualizer:hover {
    border: round $accent-pink;
    border-title-color: $text-primary;
}

#eq-vis-toggle {
    layout: horizontal;
    align: center middle;
    width: 100%;
    height: 1;
    margin-top: 0;
}

.toggle-btn {
    color: $text-muted;
    margin: 0 2;
    text-style: bold;
}

.toggle-btn.active {
    color: $accent;
    border-bottom: solid $accent;
}

/* Lyrics & Queue styling */
.lyric-line {
    text-align: center;
    width: 100%;
    padding: 0 1;
    height: auto;
    transition: color 400ms, background 400ms;
}

.lyric-line.active {
    background: $accent 15%;
    color: #ffffff;
    text-style: bold;
    padding: 1 2;
    margin: 1 0;
}

.lyric-line.near-active {
    color: $text-primary 75%;
}

.lyric-line.inactive {
    color: $text-muted 50%;
}

#queue-list {
    width: 100%;
    height: 100%;
    background: transparent;
    padding: 0;
    margin: 0;
}

QueueItemWidget {
    height: 2;
    width: 100%;
}

.queue-item {
    layout: horizontal;
    align: left middle;
    height: 2;
    width: 100%;
    padding: 0 1;
    margin-bottom: 0;
    border-bottom: none;
    transition: background 300ms;
}

.queue-item:hover {
    background: #181926;
}

.queue-item:hover .queue-title {
    color: $accent;
}

.queue-thumb {
    width: 3;
    height: 1;
    background: $border;
    margin-right: 2;
    content-align: center middle;
}

.queue-details {
    layout: vertical;
    width: 1fr;
}

.queue-title {
    color: $text-primary;
    text-style: bold;
}

.queue-artist {
    color: $text-muted;
}

#queue-header {
    layout: horizontal;
    height: 3;
    align: right middle;
    width: 100%;
    margin-bottom: 1;
    border-bottom: solid $border;
}

#autoplay-lbl {
    background: #181926;
    color: $accent-pink;
    border: round $border;
    text-style: bold;
    padding: 0 2;
    height: 1;
    margin-right: 2;
    align: right middle;
    transition: background 300ms, color 300ms;
}

#autoplay-lbl:hover {
    background: $accent-pink;
    color: #ffffff;
    border: round $accent-pink;
}

.active-track {
    background: #181926;
    color: $text-primary;
    border-left: thick $accent-pink;
}

.active-track .queue-title {
    color: $accent;
    text-style: bold;
}

.active-track .queue-artist {
    color: $text-muted;
}

/* Immersive Full-Screen Lyrics Mode rules */
#main-layout.fullscreen-lyrics-active #player-pane {
    display: none;
}
#main-layout.fullscreen-lyrics-active #eq-pane {
    display: none;
}
#main-layout.fullscreen-lyrics-active #queue-view {
    display: none;
}
#main-layout.fullscreen-lyrics-active #right-pane {
    width: 1fr;
    height: 100%;
}
#main-layout.fullscreen-lyrics-active #lyrics-view {
    height: 100%;
    border: none;
}

/* Premium Header and Footer overlays */
Header {
    background: #0a0b10;
    color: $accent;
    text-style: bold;
    height: 1;
    border-bottom: solid $border;
}

HeaderClock {
    background: #131520;
    color: $accent-pink;
    text-style: bold;
}

Footer {
    background: #0a0b10;
    color: $text-muted;
    height: 1;
    border-top: solid $border;
}

FooterKey {
    background: #131520;
    color: $text-primary;
    margin: 0 1;
}

FooterKey:hover {
    background: $accent-pink;
    color: #ffffff;
}

FooterKey .footer-key--key {
    color: $accent;
    text-style: bold;
}

FooterKey .footer-key--description {
    color: $text-primary;
}

/* Glass-style Select Dropdowns */
Select {
    width: 24;
    background: #181926;
    color: $text-primary;
    border: round $border;
    height: 3;
}

Select:focus {
    border: round $accent;
}

Select__control {
    color: $text-primary;
}

Select__overlay {
    background: #131520;
    border: round $border;
}
